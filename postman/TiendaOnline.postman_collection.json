              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve un array de productos con los campos esperados', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    pm.expect(body.length).to.be.above(0);",
                  "    pm.expect(body[0]).to.have.property('id');",
                  "    pm.expect(body[0]).to.have.property('nombre');",
                  "    pm.expect(body[0]).to.have.property('precio');",
                  "    pm.expect(body[0]).to.have.property('stock');",
                  "});"
                ]
              }
            }
          ]
        },
