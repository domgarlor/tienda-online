              ]
            },
            "description": "Usuario ADMIN, sin cliente asociado. Guarda el token en {{token_admin}}, usado por las requests de las carpetas ADMIN."
          },
          "response": []
        },
        {
          "name": "Registro nuevo cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 (creado) o 409 (username ya existente)', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const dataRegistro = pm.response.json();",
                  "    pm.collectionVariables.set('token', dataRegistro.token);",
                  "",
                  "    pm.test('Devuelve token y clienteId', function () {",
                  "        pm.expect(dataRegistro.token).to.be.a('string').and.not.empty;",
                  "        pm.expect(dataRegistro.clienteId).to.be.a('number');",
                  "    });",
                  "    console.log('Cliente creado con id ' + dataRegistro.clienteId + ', token guardado en {{token}}');",
                  "} else {",
                  "    pm.test('El 409 es por usuario duplicado', function () {",
                  "        pm.expect(pm.response.json().codigo).to.eql('USUARIO_YA_EXISTE');",
                  "    });",
                  "    console.warn('Registro fallo (usuario ya existe), no se actualiza el token');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"marta\",\n  \"password\": \"marta123\",\n  \"nombre\": \"Marta Ruiz\",\n  \"email\": \"marta@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Crea un Cliente + Usuario nuevos a la vez y devuelve un token (auto-login). Cambia el username si ya existe."
          },
          "response": []
        }
      ]
    },
