    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lineas\": [\n    { \"productoId\": 1, \"cantidad\": 2 },\n    { \"productoId\": 5, \"cantidad\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "El clienteId se deduce del token ({{token}}), no se envía en el body. Ejecuta antes 'Login - ana' o 'Login - luis'."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const pedido = pm.response.json();",
                  "    pm.collectionVariables.set('pedidoId', pedido.id);",
                  "",
                  "    pm.test('El pedido tiene 2 lineas y queda PENDIENTE', function () {",
                  "        pm.expect(pedido.lineas).to.be.an('array').with.lengthOf(2);",
                  "        pm.expect(pedido.estado).to.eql('PENDIENTE');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
