    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - ana (CLIENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const dataAna = pm.response.json();",
                  "    pm.collectionVariables.set('token', dataAna.token);",
                  "    pm.collectionVariables.set('token_ana', dataAna.token);",
                  "",
                  "    pm.test('Devuelve token no vacio', function () {",
                  "        pm.expect(dataAna.token).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test('Usuario y rol correctos', function () {",
                  "        pm.expect(dataAna.username).to.eql('ana');",
                  "        pm.expect(dataAna.rol).to.eql('CLIENTE');",
                  "        pm.expect(dataAna.clienteId).to.eql(1);",
                  "    });",
                  "} else {",
                  "    console.warn('Login de ana fallo, no se actualiza el token: ' + pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"password\": \"ana123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Usuario semilla ligado a la cliente Ana Torres (id 1). Al enviarla, el script de Tests guarda el token en {{token}} y {{token_ana}}."
          },
          "response": []
        },
