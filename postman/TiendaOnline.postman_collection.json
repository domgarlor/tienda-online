            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alfombrilla XL\",\n  \"precio\": 15.50,\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Requiere haber ejecutado antes 'Login - admin'."
          },
          "response": []
        }
      ]
    },
    {
