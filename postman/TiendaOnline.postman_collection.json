        {
          "name": "Login - admin (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const dataAdmin = pm.response.json();",
                  "    pm.collectionVariables.set('token_admin', dataAdmin.token);",
                  "",
                  "    pm.test('Devuelve token no vacio', function () {",
                  "        pm.expect(dataAdmin.token).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test('Usuario y rol correctos', function () {",
                  "        pm.expect(dataAdmin.username).to.eql('admin');",
                  "        pm.expect(dataAdmin.rol).to.eql('ADMIN');",
                  "    });",
                  "} else {",
                  "    console.warn('Login de admin fallo, no se actualiza el token: ' + pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
