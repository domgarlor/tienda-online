              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente de prueba\",\n  \"email\": \"{{$randomEmail}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/clientes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "description": "Crea solo el registro de Cliente (sin credenciales de login). El email es aleatorio ({{$randomEmail}}, variable dinamica de Postman) para no chocar con el indice unico si repites la request. Para un cliente que tambien pueda autenticarse, usa Registro nuevo cliente en la carpeta Auth."
          },
          "response": []
        }
      ]
    },
